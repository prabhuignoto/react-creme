{
  "name": "react-creme",
  "version": "1.0.0",
  "description": "Mono repo for react-creme",
  "directories": {
    "lib": "lib",
    "documentation": "documentation"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-classes": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@relative-ci/agent": "^4.3.1",
    "@sentry/react": "^10.30.0",
    "@sentry/tracing": "^7.120.4",
    "@types/bluebird": "^3.5.42",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "autoprefixer": "^10.4.23",
    "cssnano": "^7.1.2",
    "dompurify": "^3.3.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^29.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-bem-linter": "^4.0.1",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.5.0",
    "postcss-reporter": "^7.1.0",
    "prettier": "^3.7.4",
    "pretty-quick": "^4.2.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sass": "^1.96.0",
    "snyk": "^1.1301.1",
    "stylelint": "16.26.1",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.13.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "lint": "bunx turbo run oxlint && bunx turbo run lint",
    "oxlint": "bunx oxlint . --deny-warnings",
    "format": "bunx turbo run format",
    "build": "bunx turbo run build",
    "prepare": "husky install",
    "dev": "bunx turbo run dev --filter=*docu*",
    "story": "bunx turbo run dev --filter=*story*",
    "test": "bunx turbo run test",
    "test:ci": "bunx turbo run test:ci",
    "all": "bunx turbo run format lint build && bunx turbo run test:ci",
    "build:lib": "bunx turbo run build:lib",
    "build:doc": "bunx turbo run build:doc",
    "ci": "bunx turbo run ci",
    "snyk": "bunx turbo run snyk",
    "fix-css": "bunx turbo run fix-css",
    "fix-js": "bunx turbo run fix-js",
    "fix-all": "bunx concurrently \"bun fix-css\" \"bun fix-js\"",
    "clean": "bun fix-all && bun format && bun lint",
    "percy": "bunx turbo run percy",
    "build-story": "bunx turbo run build-story",
    "relative-ci": "relative-ci",
    "knip": "knip",
    "knip:production": "knip --production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabhuignoto/react-creme.git"
  },
  "author": "Prabhu Murthy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/prabhuignoto/react-creme/issues"
  },
  "homepage": "https://github.com/prabhuignoto/react-creme#readme",
  "workspaces": [
    "packages/**",
    "!**/test/**"
  ],
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=20.18.1",
    "bun": ">=1.1.0"
  },
  "resolutions": {
    "nth-check": "^2.0.1",
    "postcss": "^8.2.13",
    "glob-parent": "^5.1.2",
    "trim": "^0.0.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "bunx eslint --fix"
    ],
    "**/*.{js,jsx,mjs,cjs}": [
      "prettier --write",
      "bunx eslint --fix"
    ],
    "packages/lib/**/*.{scss,css}": [
      "prettier --write",
      "bunx stylelint --fix"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@swc/plugin-emotion": "^14.0.1",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.15",
    "browserslist": "^4.28.1",
    "knip": "^5.73.4",
    "lightningcss": "^1.30.2",
    "oxlint": "^1.32.0",
    "postcss-scss": "^4.0.9",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "vite-plugin-lightningcss": "^0.0.5",
    "vite-plugin-pwa": "^1.2.0"
  }
}
